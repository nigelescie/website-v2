# Environment variables - never commit these
.env
.env.local
.env.production

# Environment-specific JS configs (contain credentials)
public/js/environment/environment.*.js

# Dependencies
node_modules/

# Logs
*.log
email_debug.log
npm-debug.log*

# Runtime data
data/subscribers.json
data/sessions.json
data/reset-tokens.json
data/analytics.json
data/analytics-archives.json
data/content.json

# Debug/test artifacts
public/debug-*.html
public/test-*.html
test-cors.html

# OS files
.DS_Store
Thumbs.db

# Uploads (user-generated content)
public/uploads/

#kiro
.kiro/*
